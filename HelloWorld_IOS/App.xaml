<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:HelloWorld_IOS"
             xmlns:conv="clr-namespace:HelloWorld_IOS.Converters"
             x:Class="HelloWorld_IOS.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:ActiveTabBgConverter x:Key="ActiveTabBgConverter" />
            <conv:ProgressConverter    x:Key="ProgressConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
