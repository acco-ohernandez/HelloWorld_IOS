<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HelloWorld_IOS.ViewModels"
             x:Class="HelloWorld_IOS.Views.DiagnosticsPage"
             x:DataType="vm:DiagnosticsViewModel"
             Title="Diagnostics"
             BackgroundColor="#1e1e1e">

    <Grid RowDefinitions="44,*,28">

        <!-- Toolbar: Close / title / Refresh + Export all -->
        <Grid Grid.Row="0" BackgroundColor="#2b2b2b" Padding="8,4" ColumnDefinitions="Auto,*,Auto,Auto">
            <Button Grid.Column="0" Text="Close"
                    Clicked="OnCloseClicked"
                    BackgroundColor="#444" TextColor="White"
                    FontSize="13" Padding="12,4" />
            <Label  Grid.Column="1" Text="Diagnostics"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    TextColor="White" FontSize="14" FontAttributes="Bold" />
            <Button Grid.Column="2" Text="Export all"
                    Clicked="OnExportAllClicked"
                    BackgroundColor="#3c7adc" TextColor="White"
                    FontSize="13" Padding="10,4" Margin="0,0,6,0" />
            <Button Grid.Column="3" Text="Refresh"
                    Clicked="OnRefreshClicked"
                    BackgroundColor="#444" TextColor="White"
                    FontSize="13" Padding="10,4" />
        </Grid>

        <!-- Master/detail split: list on the left, content on the right -->
        <Grid Grid.Row="1" ColumnDefinitions="280,*">

            <!-- Session list -->
            <CollectionView Grid.Column="0"
                            ItemsSource="{Binding Sessions}"
                            SelectionMode="Single"
                            SelectedItem="{Binding Selected, Mode=TwoWay}"
                            BackgroundColor="#181818">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionLogEntry">
                        <Grid Padding="10,8" RowDefinitions="Auto,Auto" RowSpacing="2">
                            <Label Grid.Row="0" Text="{Binding Name}"
                                   TextColor="White" FontSize="13" LineBreakMode="TailTruncation" />
                            <Label Grid.Row="1" FontSize="11" TextColor="#888">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0} · {1}">
                                        <Binding Path="DisplayTime" />
                                        <Binding Path="DisplaySize" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No sessions yet."
                           TextColor="#666" FontSize="13"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- Detail pane -->
            <Grid Grid.Column="1" RowDefinitions="36,*" BackgroundColor="#141414">
                <!-- Detail toolbar -->
                <Grid Grid.Row="0" BackgroundColor="#222" Padding="8,4" ColumnDefinitions="*,Auto,Auto">
                    <Label Grid.Column="0"
                           Text="{Binding Selected.Name, FallbackValue='Select a session →'}"
                           TextColor="#ccc" FontSize="12" VerticalOptions="Center"
                           LineBreakMode="TailTruncation" />
                    <Button Grid.Column="1" Text="Share"
                            Clicked="OnShareClicked"
                            BackgroundColor="#3c7adc" TextColor="White"
                            FontSize="12" Padding="10,2" Margin="0,0,6,0" />
                    <Button Grid.Column="2" Text="Delete"
                            Clicked="OnDeleteClicked"
                            BackgroundColor="#7a3c3c" TextColor="White"
                            FontSize="12" Padding="10,2" />
                </Grid>

                <ScrollView Grid.Row="1" Orientation="Both">
                    <Label Text="{Binding SelectedContent}"
                           TextColor="#dcdcdc"
                           FontFamily="Courier New" FontSize="11"
                           Padding="10"
                           LineBreakMode="NoWrap" />
                </ScrollView>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="2" BackgroundColor="#181818" Padding="10,4" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" Text="{Binding StatusText}"
                   TextColor="#888" FontSize="11" VerticalOptions="Center"
                   LineBreakMode="TailTruncation" />
            <Button Grid.Column="1" Text="Clear all (keep active)"
                    Clicked="OnClearAllClicked"
                    BackgroundColor="#2b2b2b" TextColor="#ccc"
                    FontSize="11" Padding="8,2" />
        </Grid>
    </Grid>

</ContentPage>
