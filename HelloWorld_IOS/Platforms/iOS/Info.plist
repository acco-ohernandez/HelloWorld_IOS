<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.accoes.nwd3dviewer</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- iPad only. iPhone (1) removed — the MAUI layout is iPad-tuned and the
	     Custom App distribution targets managed iPads only. If iPhone support
	     ever becomes a requirement, undo this AND tune the responsive layout
	     in ViewerPage.xaml. -->
	<key>UIDeviceFamily</key>
	<array>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>

	<!-- Export-compliance declaration. The app uses only Apple's built-in HTTPS
	     (SecureStorage / WKWebView fetches) — no custom crypto, no exempt-from-export
	     primitives. Setting this to false skips the export-compliance question on
	     every App Store Connect upload. Re-evaluate if the app ever adds custom
	     crypto, end-to-end encryption, or third-party encryption libraries. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Custom UTIs for the 3D model formats we open. None of these have a
	     public Apple-defined UTI, so we declare our own. The Document Picker
	     reads these to filter what's selectable from Files / iCloud / Box /
	     Drive. Each conforms to public.data so the system picker fallback
	     ("any data file") still works for providers that ignore custom UTIs. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key><string>com.accoes.ifc</string>
			<key>UTTypeDescription</key><string>Industry Foundation Classes Model</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key><array><string>ifc</string></array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key><string>com.accoes.gltf</string>
			<key>UTTypeDescription</key><string>glTF Model</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key><array><string>gltf</string></array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key><string>com.accoes.glb</string>
			<key>UTTypeDescription</key><string>glTF Binary Model</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key><array><string>glb</string></array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key><string>com.accoes.obj</string>
			<key>UTTypeDescription</key><string>Wavefront OBJ Model</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string><string>public.text</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key><array><string>obj</string></array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key><string>com.accoes.fbx</string>
			<key>UTTypeDescription</key><string>FBX Model</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key><array><string>fbx</string></array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key><string>com.accoes.stl</string>
			<key>UTTypeDescription</key><string>Stereolithography Model</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key><array><string>stl</string></array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key><string>com.accoes.nwd</string>
			<key>UTTypeDescription</key><string>Navisworks Document</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key><array><string>nwd</string></array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key><string>com.accoes.nwc</string>
			<key>UTTypeDescription</key><string>Navisworks Cache</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key><array><string>nwc</string></array>
			</dict>
		</dict>
	</array>

	<!-- Tell the system we can open these document types so they appear in
	     "Open With" menus and Document Picker filters. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key><string>3D Model</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSHandlerRank</key><string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.accoes.ifc</string>
				<string>com.accoes.gltf</string>
				<string>com.accoes.glb</string>
				<string>com.accoes.obj</string>
				<string>com.accoes.fbx</string>
				<string>com.accoes.stl</string>
				<string>com.accoes.nwd</string>
				<string>com.accoes.nwc</string>
			</array>
		</dict>
	</array>

	<!-- Sandbox: Files-app integration. Lets the user place models in
	     "On My iPad / 3D Model Viewer" and lets external apps open files
	     stored there. -->
	<key>UIFileSharingEnabled</key><true/>
	<key>LSSupportsOpeningDocumentsInPlace</key><true/>
</dict>
</plist>
